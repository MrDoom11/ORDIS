{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORDIS",
  "version": "0.1.0",
  "identifier": "local.ordis.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ORDIS",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "transparent": true,
        "dragDropEnabled": false,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
