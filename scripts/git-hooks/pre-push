#!/bin/sh
# Trava de push. Para o repositório público (o remoto "origin"), qualquer
# branch é aceito, mas os commits que ele ainda não tem passam por:
# - nova verificação do conteúdo (dados pessoais e segredos);
# - exigência do e-mail sem dados pessoais do GitHub (@users.noreply.github.com).
# Outros remotos (como o privado) passam sem restrição.
remoto="$1"
dir=$(dirname "$0")
[ "$remoto" = "origin" ] || exit 0

zero=0000000000000000000000000000000000000000
falhou=0
while read -r ref_local sha_local ref_remoto sha_remoto; do
  [ "$sha_local" = "$zero" ] && continue   # remoção de branch
  # Branch novo: só o que nenhum branch do público já tem.
  if [ "$sha_remoto" = "$zero" ]; then
    commits=$(git rev-list "$sha_local" --not --remotes=origin)
  else
    commits=$(git rev-list "$sha_remoto..$sha_local")
  fi
  [ -n "$commits" ] || continue
  emails=$(git show -s --format='%ae%n%ce' $commits | sort -u | grep -v '@users.noreply.github.com$' | grep -v '^noreply@anthropic.com$')
  if [ -n "$emails" ]; then
    echo "Push recusado ($ref_remoto): commits com e-mail que fica público: $emails" >&2
    echo "Use o endereço @users.noreply.github.com (git config user.email)." >&2
    falhou=1
  fi
  if ! git show -p --no-color -U0 --format= $commits | grep '^+' | grep -v '^+++ ' | sh "$dir/verificar.sh"; then
    echo "Push recusado ($ref_remoto): os commits acima contêm dados pessoais ou segredos." >&2
    falhou=1
  fi
done
exit $falhou
